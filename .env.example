# Optional: Supabase (email/password + cloud sync). Copy to .env.local for local dev.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional: receipt scan (Vercel serverless). Local dev with vercel dev:
# VITE_SCAN_RECEIPT_URL=http://localhost:3000

# Optional: chat Web Push (Vercel). Phone/browser alerts when Evenly is closed.
# npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=the_public_key
# VAPID_PRIVATE_KEY=the_private_key
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
